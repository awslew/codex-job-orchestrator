{
  "description": "worker 权限白名单（中性模板，单一事实来源）。defaultMode=bypassPermissions 表示 worker 不逐项审批：文件编辑、Bash 命令、工具调用一律放行，且不产生任何模型分类请求（那类自动分类器会持续超时、阻塞已批准的操作并反复消耗额度，本仓库不使用该机制）。安全性全部由 deny 数组硬性兜底——deny 的优先级高于 allow 和 defaultMode，命中即拒绝。三个区块的作用、以及如何按需增删，见同目录的 worker-whitelist.README.md。",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Glob",
      "Grep",
      "NotebookEdit",
      "TodoWrite",
      "Task",
      "Skill",

      "Bash(git *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Bash(tsc *)",
      "Bash(tsx *)",
      "Bash(ts-node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",

      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(where *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(hostname *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(tasklist *)",

      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(tee *)",
      "Bash(tar *)",
      "Bash(unzip *)",
      "Bash(zip *)",
      "Bash(7z *)",
      "Bash(sha256sum *)",
      "Bash(md5sum *)",
      "Bash(sha1sum *)",
      "Bash(certutil *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",

      "Bash(shutdown *)",
      "Bash(reg delete *)",
      "Bash(format *)",

      "Bash(rm -rf /*)",
      "Bash(rm -fr /*)",
      "Bash(rm -rf /c/)",
      "Bash(rm -rf /d/)",

      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",

      "Write(C:/Windows/**)",
      "Edit(C:/Windows/**)",
      "MultiEdit(C:/Windows/**)",
      "Write(C:/Program Files/**)",
      "Edit(C:/Program Files/**)",
      "MultiEdit(C:/Program Files/**)"
    ]
  }
}
