# ============================================================================
# codex-job-orchestrator — 版本库排除规则
#
# 前提：本仓库以 MIT 许可公开。任何可能含「真实任务内容 / 个人绝对路径 / 凭据 /
# 本机环境快照」的文件都必须在这里排除，并且要在 `git init` **之前**就位 ——
# 一旦进了第一个 commit，私人数据就写进历史了，之后只能靠重写历史来擦。
#
# 格式注意：.gitignore 不支持行尾注释——`foo/  # 说明` 会被当成一个含空格和 #
# 的完整模式，永远匹配不到文件。因此下面每一条的说明都写在规则**上一行**，
# 规则行只留模式本身。新增排除项请沿用同一格式。
# ============================================================================

# ── 构建产物（`npm run build` 可原地再生，无信息价值、体积大） ───────────────
# 第三方依赖，由锁文件确定版本，本地 install 即可再生
node_modules/
# tsc 的生产构建输出，不是源码，禁止入库
dist/
# tsconfig.test.json 的测试构建输出，同样是产物
dist-test/
# 手工/脚本备份构建留下的带时间戳快照目录，一次性产物
dist-backup-*/

# ── 运行时状态：本清单中优先级最高的一项，必须排除 ─────────────────────────
# runtime/ 下含 jobs/ logs/ reports/ settings/ registry/ claims/：
#   * jobs/*.json —— 每个 job 的完整任务内容（用户真实 prompt、工作目录绝对路径）
#   * logs/*.log  —— worker 的 stream-json 原始输出，含命令、文件路径、工具输入
#   * settings/   —— 为该 job 注入的 per-job 设置，会透传用户的 base URL 与 token
#   * reports/    —— worker 写回的交付报告正文
#   * registry/   —— 本机实例注册表，含 PID 与绝对路径
# 这是「用户的私有工作内容」，与代码无关，公开仓库里出现即事故。
runtime/

# ── 取证与审计产物（含真实文件树、命令回显、截图） ─────────────────────────
# 手工/脚本备份目录，通常是某次改动前的整树快照
backups/
# 审计取证材料：真实路径、命令输出、截图，仅限本机排查
audit-evidence/
# orchestrator 的终端/界面截图输出目录，一次性证据
.orch-shots/

# ── smoke 测试跑出来的产物 ─────────────────────────────────────────────────
# 注意：smoke/*.mjs 是测试脚本本体，必须入库；这里只排除它们运行后的产物。
smoke/out/
smoke/tmp/
smoke/.tmp/
smoke/artifacts/
smoke/*.stdout.txt
smoke/*.stderr.txt

# ── 测试跑出来的产物（落在 test/ 下） ──────────────────────────────────────
# test/fake-acceptance.mjs 的 --mark 会把标记文件写进 process.cwd()，测试以
# test/ 为工作目录运行时就会在这里留下 0 字节的 *.txt。它们是运行产物，不是夹具。
test/*.txt

# ── 临时文件与备份文件 ─────────────────────────────────────────────────────
# 手工备份文件（如 index.ts.bak-20260907）
*.bak-*
# 同上，专指 TS 源码的备份变体，命名差异兜底
*.ts.bak-*
# 任何散落的日志文件，通常含真实任务输出
*.log
# tsc 增量编译缓存，内容与本机路径绑定
*.tsbuildinfo

# ── init 脚本产出（可能含用户凭据） ───────────────────────────────────────
# tools/init.mjs 会把探测到的本机路径、以及用户填写的 base URL / auth token
# 写进 generated/。该目录内部另有一个内容为 `*` 的自排除 .gitignore，这里再加
# 一层，防止那个自排除文件被误删后整个目录直接入库。
generated/

# ── 本机环境与凭据 ────────────────────────────────────────────────────────
# 环境变量文件，通常含 token / API key
.env
# 任何 *.local.json 都约定为本机私有覆盖，不入库
*.local.json
# config/hermetic-mcp.json 是使用者本机的 worker 侧 MCP 快照，内含私有 MCP 服务名
# 与个人绝对路径；只允许中性的示例 config/hermetic-mcp.example.json 入库。
config/hermetic-mcp.json

# ── 操作系统与编辑器 ──────────────────────────────────────────────────────
# macOS Finder 元数据文件
.DS_Store
# Windows 资源管理器缩略图缓存
Thumbs.db
# JetBrains 本地工程配置
.idea/
# VS Code 本地工程配置（launch.json 常含本机绝对路径）
.vscode/
